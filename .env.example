# ── Whisper STT ─────────────────────────────────────────
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
# Options: cpu | cuda | auto

# ── Agent ───────────────────────────────────────────────
DEFAULT_THREAD_ID=tech-van-001
VECTOR_STORE_PATH=./vector_store
