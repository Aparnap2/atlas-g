# ── Ollama ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GRANITE_MODEL=granite-docling:latest
EMBED_MODEL=nomic-embed-text

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kokoro TTS ──────────────────────────────────────────
KOKORO_VOICE=af_heart
